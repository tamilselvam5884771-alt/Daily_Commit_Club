# Server Configuration
PORT=5000
NODE_ENV=development
TIMEZONE=Asia/Kolkata

# Database
MONGO_URI=mongodb://127.0.0.1:27017/daily_commit_club

# JWT Authentication
JWT_SECRET=daily_commit_club_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
# Documented Scopes: read:user, user:email, public_repo, repo

# Frontend Application Base URL
FRONTEND_URL=http://localhost:3000

# Nodemailer Email Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="Daily Commit Club <no-reply@dailycommit.club>"

# Cron Schedule Configurations (Asia/Kolkata)
# Default: Morning Reminder 09:00, Last Chance 21:00, Daily Check 23:59
MORNING_REMINDER_CRON=0 9 * * *
LAST_CHANCE_CRON=0 21 * * *
DAILY_CHECK_CRON=59 23 * * *

# Challenge Rules
DAMAGE_PER_MISSED_DAY=40

# Dev / Testing Endpoints Enable Flag
ALLOW_DEV_ENDPOINTS=true
