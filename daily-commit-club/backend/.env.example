# Server Configuration
PORT=5000
NODE_ENV=development
TIMEZONE=Asia/Kolkata

# Database (Production uses process.env.MONGODB_URI from Vercel)
MONGODB_URI=mongodb://127.0.0.1:27017/daily_commit_club

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# GitHub OAuth / REST API
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Frontend Application Base URL
FRONTEND_URL=http://localhost:3000

# Nodemailer Email Configuration (Optional)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="Daily Commit Club <no-reply@dailycommit.club>"

# Cron Schedule Configurations (Asia/Kolkata)
MORNING_REMINDER_CRON=0 9 * * *
LAST_CHANCE_CRON=0 21 * * *
DAILY_CHECK_CRON=59 23 * * *

# Challenge Rules
DAMAGE_PER_MISSED_DAY=40

# Dev / Testing Endpoints Enable Flag
ALLOW_DEV_ENDPOINTS=true
